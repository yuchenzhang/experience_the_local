.container
  .row-fluid
    .span2
    .span8
      .navbar
        .navbar-inner
          %a.brand{href:'#'}
            Experience With Local
          %ul.nav
            %li.active
              %a.dropdown-toggle{:'data-toggle' => 'dropdown'}
                Locate an Attraction
                %b.caret
              %ul.dropdown-menu
                %li
                  %a#map_view_link{href:'#'}
                    %i.icon-map-marker
                    Map View
                %li
                  %a#list_view_link{href:'#'}
                    %i.icon-th-large
                    Featuring
            %li
              %a.dropdown-toggle{:'data-toggle' => 'dropdown'}
                Locate a Guide
                %b.caret
            %ul.dropdown-menu
              %li
                %a#map_view_link{href:'#'}
                  %i.icon-map-marker
                  Map View
              %li
                %a#list_view_link{href:'#'}
                  %i.icon-th-large
                  Recommended
      .row-fluid#map_view
        = render 'map'
      .row-fluid#list_view
        = render 'attraction'
      .row-fluid#profile_view
        = render 'profile'
    .span2

:javascript
  document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('list_view').style.display = 'none';
    document.getElementById('profile_view').style.display = 'none';
  });

  document.addEventListener('click', function(e) {
    if (e.target && e.target.id === 'map_view_link') {
      document.getElementById('map_view').style.display = '';
      document.getElementById('list_view').style.display = 'none';
      document.getElementById('profile_view').style.display = 'none';
    }
    if (e.target && e.target.id === 'list_view_link') {
      document.getElementById('map_view').style.display = 'none';
      document.getElementById('list_view').style.display = '';
      document.getElementById('profile_view').style.display = 'none';
    }
    if (e.target && e.target.id === 'profile_view_link') {
      document.getElementById('map_view').style.display = 'none';
      document.getElementById('list_view').style.display = 'none';
      document.getElementById('profile_view').style.display = '';
    }
  });
